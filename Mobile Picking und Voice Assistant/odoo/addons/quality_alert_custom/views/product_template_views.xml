<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Die Sollbeschreibung gehoert an den ARTIKEL, nicht an die Meldung:
         sie beschreibt den Neuzustand und gilt fuer jede kuenftige Meldung zu
         diesem Artikel. Sichtbar im Reiter "Lager", weil sie dort neben den
         uebrigen logistischen Angaben steht und nicht zwischen Preisen. -->
    <record id="product_template_form_ai_reference" model="ir.ui.view">
        <field name="name">product.template.form.ai.reference</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']//group" position="after">
                <group string="Bildbewertung" name="ai_reference">
                    <field name="ai_reference_description"
                           placeholder="toy building brick, yellow, 2x2 studs with rounded top"/>
                    <field name="ai_reference_reviewed"/>
                    <field name="ai_reference_image_sha1" groups="base.group_no_one"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
