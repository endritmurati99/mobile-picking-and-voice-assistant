<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <!-- Lego-Klemmbausteine wiegen wenige Gramm. Mit den Odoo-Standard-
         zwei Nachkommastellen wuerde jedes Gewicht unter 0,005 kg als 0,00
         gespeichert und die Gewichtssumme auf dem Versandlabel bliebe leer. -->
    <record id="product.decimal_stock_weight" model="decimal.precision">
        <field name="digits">3</field>
    </record>
</odoo>
