<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 dropped res.groups.category_id in favor of res.groups.privilege_id;
         these groups are not attached to a shared privilege so plain res.groups
         records are sufficient (verified against the odoo19-trial runtime). -->
    <record id="group_picker" model="res.groups">
        <field name="name">Picking Assistant Picker</field>
    </record>

    <record id="group_supervisor" model="res.groups">
        <field name="name">Picking Assistant Supervisor</field>
        <field name="implied_ids" eval="[(4, ref('group_picker'))]"/>
    </record>

    <record id="group_api_service" model="res.groups">
        <field name="name">Picking Assistant API Service</field>
    </record>
</odoo>
