            { "id": "b03", "name": "callback_body", "type": "object", "value": "={{ (() => { const acc = $('Build Acceptance').item.json; const p = acc.payload; const ids = acc.callback_ids_by_generation[String(acc.delivery_generation)]; if (!ids || !ids.terminal) { throw new Error('no callback id for signed delivery generation'); } const numberPart = String(p.picking_name || '').split('/').pop() || String(p.picking_id); const tracking = 'PWR-' + $json.carrier_code + '-' + numberPart + '-' + String(acc.event_id).replace(/-/g, '').slice(0, 4).toUpperCase(); return { schema_version: 'v2', callback_name: 'shipping.label.status.v1', callback_id: ids.terminal, source_event_id: acc.event_id, correlation_id: acc.correlation_id, odoo_instance: acc.odoo_instance, job_id: acc.job_id, sequence: 1, attempt: 1, delivery_generation: acc.delivery_generation, processing_lease_token: $('PWR Signed Acceptance').item.json.processing_lease_token, status: 'succeeded', execution_id: String($execution.id), occurred_at: new Date().toISOString(), next_retry_at: null, result: { carrier_code: $json.carrier_code, carrier_name: $json.carrier_name, service_note: $json.service_note, tracking_number: tracking, label: { picking_name: p.picking_name, sender_name: p.warehouse || acc.odoo_instance, recipient: p.recipient, items: p.items, total_weight_kg: p.total_weight_kg } }, error: null, metrics: { carrier_code: String($json.carrier_code) } }; })() }}" }
          ]
        },
        "options": {}
      }
