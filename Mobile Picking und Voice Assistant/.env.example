# .env.example — Kopieren nach .env und Werte ausfüllen
# NIEMALS .env committen!

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=odoo
POSTGRES_PASSWORD=HIER_SICHERES_PASSWORT_SETZEN
POSTGRES_HOST_PORT=5433

# ── Odoo ─────────────────────────────────────────────────────
ODOO_DB=masterfischer_o19
ODOO_USER=admin
ODOO_PASSWORD=ADMIN_PASSWORT_ODER_APP_PASSWORT
ODOO_API_KEY=WIRD_NACH_ODOO_SETUP_GENERIERT
# Optionale weitere Odoo-Profile fuer den PWA-Lagerumschalter.
# Secrets nur in .env pflegen, nie committen.
# Beispiel:
# Optionaler zweiter lokaler Odoo-Container: docker compose --profile second-odoo up -d odoo-lager-2
ODOO_LAGER2_PORT=8070
# # Ohne dieses Flag stellt das Backend kein einziges Outbox-Ereignis zu.
DISPATCHER_ENABLED=true
ODOO_INSTANCES_JSON={"lager-2":{"display_name":"Lager 2","url":"http://odoo-lager-2:8069","db":"lager2_o19","user":"admin","password":"ZWEITES_ODOO_PASSWORT"}}
ODOO_INSTANCES_JSON=

# ── Lokales LLM (Ollama) fuer KI-Qualitaetsbewertung ─────────
# Laeuft offline auf dem Lab-PC (kein Internet noetig). Faellt bei Ausfall
# automatisch auf die n8n-Heuristik zurueck. Modell nach erstem Start laden:
#   docker compose exec ollama ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama abschalten mit einem anderen Wert (z. B. "disabled").
LLM_PROVIDER=ollama
LLM_ENDPOINT=http://ollama:11434
LLM_MODEL=qwen2.5:7b
# CPU-only inference (i7-4790, no GPU): qwen2.5:7b json disposition ~45s, cold-load spikes higher
LLM_TIMEOUT_MS=90000
# Bildpruefung: ZWEI Modelle, getrennt gemessen (Begruendung in
# backend/app/config.py bei `vision_article_model`).
#   docker compose exec ollama ollama pull gemma4:12b
# VISION_ARTICLE_MODEL leer lassen faellt auf VISION_MODEL zurueck -- der
# Rueckweg, wenn gemma4:12b nicht geladen ist.
VISION_MODEL=gemma4:12b
VISION_ARTICLE_MODEL=gemma4:12b
# Artikelabgleich ueber Bildabstand (Dienst `embed`) statt ueber zwei
# Beschreibungen und ein Textmodell. primaer | schatten | off
# `schatten` misst mit, ohne zu entscheiden; `off` ist der Stand davor.
EMBED_MODE=primaer

# ── n8n ──────────────────────────────────────────────────────
# WICHTIG: Vor erstem Start generieren und SICHER aufbewahren!
# Verlust = alle n8n Credentials unwiederbringlich verloren.
# Generieren: openssl rand -hex 32
N8N_ENCRYPTION_KEY=HIER_GENERIEREN

# ── Netzwerk ─────────────────────────────────────────────────
# LAN-IP des Docker-Hosts (z.B. 192.168.1.100)
LAN_HOST=192.168.1.100

# Komma-getrennte Liste erlaubter Browser-Origins (CORS-Allowlist UND
# Origin-Gate fuer die Session-Cookies). Ersetzt das alte CORS_ORIGINS, das
# jetzt beim Start hart abgelehnt wird. In docker-compose.yml default:
# "https://${LAN_HOST}" — hier nur setzen, wenn ein abweichender Wert
# gebraucht wird (z. B. mehrere Origins fuer eine echte Produktivdomain).
# In Produktion (RUNTIME_PROFILE=production) MUESSEN alle Origins https://
# sein; Wildcard "*" oder leer wird beim Start abgelehnt.
# PWA_ORIGINS=https://pwa.example.com

# Schaltet die Produktions-Haertung ein (siehe validate_runtime_security in
# backend/app/config.py): erzwingt HTTPS-only PWA_ORIGINS, verbietet
# MOBILE_HEADER_GRACE_MODE, verlangt Odoo-Service-Credentials fuer jedes
# Profil und eine >=32-Byte N8N_WEBHOOK_SECRET. Ohne RUNTIME_PROFILE=production
# faellt der Server still auf die Development-Defaults zurueck — fuer eine
# echte Bereitstellung MUSS dieser Wert explizit auf "production" gesetzt
# werden (docker-compose.yml default ist "development").
# RUNTIME_PROFILE=production

# ── n8n Webhook ──────────────────────────────────────────────
N8N_WEBHOOK_SECRET=HIER_GENERIEREN
N8N_WEBHOOK_PATH_QUALITY_ALERT_CREATED=quality-alert-created
N8N_WEBHOOK_PATH_VOICE_EXCEPTION_QUERY=voice-exception-query
N8N_WEBHOOK_PATH_SHORTAGE_REPORTED=shortage-reported
N8N_WEBHOOK_PATH_PICK_CONFIRMED=pick-confirmed

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# Mobile workflow hardening
MOBILE_CLAIM_TTL_SECONDS=120
MOBILE_CLAIM_HEARTBEAT_SECONDS=30
MOBILE_IDEMPOTENCY_TTL_SECONDS=86400
# ACHTUNG: Grace-Mode schaltet die Session-Authentifizierung ab und vertraut den
# Klartext-Headern X-Picker-User-Id / X-Device-Id / X-Odoo-Instance. NUR fuer
# lokale Entwicklung ohne Login-Fluss. Auskommentiert lassen: wer diese Datei
# nach .env kopiert, soll NICHT versehentlich die Auth ausschalten. In
# production ist der Wert ohnehin fail-closed verboten (config.validate).
# MOBILE_HEADER_GRACE_MODE=true
N8N_CALLBACK_SECRET=HIER_GENERIEREN
N8N_SYNC_TIMEOUT_MS=7000
N8N_CIRCUIT_BREAKER_FAILURES=3
N8N_CIRCUIT_BREAKER_OPEN_SECONDS=60
OBSIDIAN_PATH=../Notzien
QUALITY_ALERT_EMAIL_FROM=
QUALITY_ALERT_EMAIL_TO=

# ── Cloudflare Tunnel ────────────────────────────────────────
# Token aus Zero Trust Dashboard → Networks → Tunnels → diti-n8n → Configure
CLOUDFLARE_TUNNEL_TOKEN=HIER_TOKEN_AUS_CLOUDFLARE_DASHBOARD

# Öffentliche HTTPS-URL für n8n Webhooks (Telegram braucht HTTPS)
WEBHOOK_URL=https://n8n.diti-ai.org

# ── Secret-Dateien (Docker Secrets) ──────────────────────────
# Jedes Secret oben kann stattdessen als Datei gemountet werden (Compose
# `secrets:` → /run/secrets/<name>). Die Datei enthaelt NUR den Wert; der
# Backend-Reader (`read_secret` in backend/app/config.py) strippt Whitespace.
#
# Zwei harte Regeln, beide fail-closed beim Start:
#  1. Direktwert UND Datei fuer dasselbe Secret gleichzeitig => Startabbruch.
#     Es gibt bewusst KEINE Vorrangregel — sonst streiten zwei Deployments
#     darueber, welches Secret gerade wirklich aktiv ist.
#  2. Die Datei darf fuer Gruppe/Andere keinerlei Rechte haben (Bits 0o077),
#     also z. B. 0600 oder 0400 — 0640/0644 wird abgelehnt.
#
# Hier stehen ausschliesslich PFADE, niemals Werte.
# SESSION_THROTTLE_HMAC_SECRET_FILE=/run/secrets/session_throttle_hmac_secret_b64
# PWR_BACKEND_TO_N8N_ACTIVE_SECRET_FILE=/run/secrets/pwr_backend_to_n8n_active_secret_b64
# PWR_BACKEND_TO_N8N_PREVIOUS_SECRET_FILE=/run/secrets/pwr_backend_to_n8n_previous_secret_b64
# PWR_N8N_TO_BACKEND_ACTIVE_SECRET_FILE=/run/secrets/pwr_n8n_to_backend_active_secret_b64
# PWR_N8N_TO_BACKEND_PREVIOUS_SECRET_FILE=/run/secrets/pwr_n8n_to_backend_previous_secret_b64
# N8N_WEBHOOK_SECRET_FILE=/run/secrets/n8n_webhook_secret
# N8N_CALLBACK_SECRET_FILE=/run/secrets/n8n_callback_secret

# ── Request-Body-Limit (zweite Schicht) ──────────────────────
# Die erste Schicht ist Caddy (`request_body { max_size 16MB }`), die zweite
# ist ein streamendes ASGI-Limit im Backend: ein direkter n8n → Backend Aufruf
# laeuft ueber das interne Netz und beruehrt Caddy nie, und `Content-Length`
# ist mit chunked Transfer-Encoding umgehbar. Default = 16 MiB, identisch zum
# Edge-Limit und zu N8N_PAYLOAD_SIZE_MAX=16 in docker-compose.yml. Diese drei
# Werte gehoeren zusammen geaendert.
# MAX_REQUEST_BODY_BYTES=16777216
