    {"id":"l4-note","type":"text","x":210,"y":385,"width":1180,"height":155,"angle":0,"strokeColor":"#166534","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":4112,"version":2,"versionNonce":5112,"isDeleted":false,"boundElements":[],"updated":1786202400000,"link":null,"locked":false,"fontSize":22,"fontFamily":1,"text":"Jede Lagerbuchung läuft durch FastAPI und Odoo; Touch, Scanner und Kamera bleiben verfügbar.\nKein Whisper-Text führt zu keiner Buchung, derzeit aber auch zu keiner akustischen Meldung.\nAssist liest nur und ruft weder n8n noch LLM auf; Nachschub wird nicht automatisch ausgelöst.","textAlign":"center","verticalAlign":"top","containerId":null,"originalText":"Jede Lagerbuchung läuft durch FastAPI und Odoo; Touch, Scanner und Kamera bleiben verfügbar.\nKein Whisper-Text führt zu keiner Buchung, derzeit aber auch zu keiner akustischen Meldung.\nAssist liest nur und ruft weder n8n noch LLM auf; Nachschub wird nicht automatisch ausgelöst.","autoResize":true,"lineHeight":1.25}
